  "info": {
    "_postman_id": "bd3dfd2a-2f28-494b-a612-8cfa2d51e058",
    "name": "SAP Sales and Distribution (SD) SAP Billing Document Sales Order Partner API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Read, cancel, and retrieve billing documents in PDF format from SAP S/4HANA. This OData service (API_BILLING_DOCUMENT_SRV) provides access to billing document headers, items, partners, and pricing elements. Supports invoices, credit memos, debit memos, and other billing document types as part of the order-to-cash cycle.\n\nContact Support:\n Name: SAP Support",
      "type": "text/plain"
    }
  }
