{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Sales and Distribution (SD) SAP Billing Document Credit Memo Request Item API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credit Memo Request Item",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve items for a credit memo request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BILLING_DOCUMENT_SRV/A_CreditMemoRequest(':CreditMemoRequest')/to_Item",
            "params": [
              {
                "name": "CreditMemoRequest",
                "value": "",
                "type": "path",
                "description": "Credit memo request number"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a collection of line items for the specified credit memo request."
        }
      ]
    }
  ],
  "bundled": true
}