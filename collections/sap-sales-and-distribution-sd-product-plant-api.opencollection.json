{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Sales and Distribution (SD) SAP Billing Document Product Plant API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product Plant",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve plant data for a product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BILLING_DOCUMENT_SRV/A_Product(':Product')/to_Plant",
            "params": [
              {
                "name": "Product",
                "value": "",
                "type": "path",
                "description": "Material number"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns plant-level data for the specified product including MRP, purchasing, and production information."
        }
      ]
    }
  ],
  "bundled": true
}